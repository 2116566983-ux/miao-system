# Streamlit 云端部署 · 凭据模板
#
# 用法：在 Streamlit Community Cloud 的应用设置里，
#       把下面内容粘到 "Secrets" 框里（不要提交这个文件的真实版本）。
#
# 本地开发**不要**用这个文件 —— 本地凭据放在项目根目录的
# start.local.bat 里（已 gitignore），启动脚本会自动读取。
#
# 这份模板对应的是"云端能不能连外部服务"的问题：
#
#   · Neo4j：**云端连不上你本机的 Neo4j**，所以这一项在云部署里
#            通常留空即可，⑥ 页会自动降级为 CSV 内存图（教学等价）。
#            除非你把 Neo4j 也部署到了有公网地址的服务器上。
#   · 云端生图 API：如果想让② 页在云端也能生成，填这一项。
#            注意免费额度通常很小，全班用会很快耗尽。

# ---- 图数据库（可选；云端通常留空）----
# NEO4J_URI = "bolt://your-neo4j-host:7687"
# NEO4J_USER = "neo4j"
# NEO4J_PASSWORD = ""

# ---- 免费云端生图 API（可选；不填则② 页显示降级提示）----
# IMAGE_API_KEY = ""
# IMAGE_API_MODEL = "Qwen/Qwen-Image-Edit"

# ---- 图片目录（不要去设）----
# 云端请**不要**设置 MIAO_IMAGE_ROOT。
# 留空时 app/paths.py 会去读仓库里的 data/images/（随仓库发布的缩略图集），
# 这正是我们想要的。设成别的路径云端反而找不到图。
# MIAO_IMAGE_ROOT = ""
