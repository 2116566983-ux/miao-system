{
  "_readme": [
    "苗绣纹样 · 多纹样组合工作流（分离式模型版）",
    "",
    "适用场景：ComfyUI 上没有标准检查点（CheckpointLoaderSimple 无模型），",
    "         但存在分离的 diffusion_models + text_encoders + vae 时。",
    "",
    "与 img2img_qwen.json 的唯一区别：",
    "   多一步 ImageBlend，把两张素材先按比例融合，再送进 VAE 编码。",
    "",
    "本模板适配的模型（服务器实测可用）：",
    "   UNETLoader  anima-preview3-base.safetensors",
    "   CLIPLoader  qwen_3_06b_base.safetensors  (type=qwen_image)",
    "   VAELoader   qwen_image_vae.safetensors",
    "",
    "占位符（由 app/workflow.py 自动注入，勿改）：",
    "   __INPUT_IMAGE__    第一张素材（含子目录时为 子目录/文件名）",
    "   __INPUT_IMAGE_2__  第二张素材",
    "   __BLEND__          两张纹样的融合比例 0–1",
    "   __POSITIVE__       正向提示词",
    "   __NEGATIVE__       负向提示词",
    "   __SEED__           随机种子",
    "   __DENOISE__        重绘强度",
    "",
    "换模型只需改下面 1/2/3 三个节点的文件名。"
  ],

  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "加载扩散模型" },
    "inputs": {
      "unet_name": "anima-preview3-base.safetensors",
      "weight_dtype": "default"
    }
  },

  "2": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "加载文本编码器" },
    "inputs": {
      "clip_name": "qwen_3_06b_base.safetensors",
      "type": "qwen_image"
    }
  },

  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "加载 VAE" },
    "inputs": {
      "vae_name": "qwen_image_vae.safetensors"
    }
  },

  "4": {
    "class_type": "LoadImage",
    "_meta": { "title": "读取第一张苗绣纹样" },
    "inputs": {
      "image": "__INPUT_IMAGE__",
      "upload": "image"
    }
  },

  "11": {
    "class_type": "LoadImage",
    "_meta": { "title": "读取第二张苗绣纹样" },
    "inputs": {
      "image": "__INPUT_IMAGE_2__",
      "upload": "image"
    }
  },

  "12": {
    "class_type": "ImageBlend",
    "_meta": { "title": "按比例融合两张纹样" },
    "inputs": {
      "image1": ["4", 0],
      "image2": ["11", 0],
      "blend_factor": "__BLEND__",
      "blend_mode": "normal"
    }
  },

  "5": {
    "class_type": "VAEEncode",
    "_meta": { "title": "融合结果编码为潜变量" },
    "inputs": {
      "pixels": ["12", 0],
      "vae": ["3", 0]
    }
  },

  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "正向提示词" },
    "inputs": {
      "text": "__POSITIVE__",
      "clip": ["2", 0]
    }
  },

  "7": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "负向提示词" },
    "inputs": {
      "text": "__NEGATIVE__",
      "clip": ["2", 0]
    }
  },

  "8": {
    "class_type": "KSampler",
    "_meta": { "title": "采样（重绘强度决定与原图的差异）" },
    "inputs": {
      "model": ["1", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0],
      "seed": "__SEED__",
      "steps": 20,
      "cfg": 2.5,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": "__DENOISE__"
    }
  },

  "9": {
    "class_type": "VAEDecode",
    "_meta": { "title": "解码为图像" },
    "inputs": {
      "samples": ["8", 0],
      "vae": ["3", 0]
    }
  },

  "10": {
    "class_type": "SaveImage",
    "_meta": { "title": "保存作品" },
    "inputs": {
      "images": ["9", 0],
      "filename_prefix": "miao_multimotif"
    }
  }
}
